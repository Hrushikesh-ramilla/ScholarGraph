# ── LLM APIs ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here        # required: powers all Gemini agent reasoning and embeddings
OPENAI_API_KEY=                                # optional: legacy fallback for OpenAI models

# ── Model names (any model string accepted by LangChain's init_chat_model) ─
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
SUPERVISOR_MODEL_NAME=google_genai:gemini-3-flash-preview
PF_AGENT_MODEL_NAME=google_genai:gemini-3.5-flash-lite
PF_FILTER_MODEL_NAME=google_genai:gemini-3.5-flash-lite
QA_AGENT_MODEL_NAME=google_genai:gemini-3.5-flash-lite
QA_EVALUATION_MODEL_NAME=google_genai:gemini-3.5-flash-lite
QA_EVALUATOR_MODEL_NAME=google_genai:gemini-3-flash-preview
QA_BASELINE_MODEL_NAME=google_genai:gemini-3.5-flash-lite

# ── LangSmith tracing (optional) ───────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=scholargraph
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── External APIs (Optional) ──────────────────────────────────────────────────
S2_API_KEY=                                     # optional: Semantic Scholar key (falls back to OpenAlex + arXiv)
COHERE_API_KEY=                                 # optional: legacy key (uses in-process ONNX FlashRank by default)

# ── Qdrant vector database ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                             # leave blank for local
QDRANT_VECTOR_SIZE=3072
QDRANT_COLLECTION=papers
QDRANT_DISTANCE=COSINE

# ── Redis (Celery broker/backend) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Paper processing ───────────────────────────────────────────────────────
PDF_DOWNLOAD_DIR=./papers
GROBID_SERVER_URL=http://localhost:8070

# ── Auth (Google OpenID Connect / OIDC) ───────────────────────────────────────
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs # Google public JWKS certs
DISABLE_AUTH=true                               # true for open local session demo

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
